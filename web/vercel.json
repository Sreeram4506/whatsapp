{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API-HOST.example.com/api/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://YOUR-API-HOST.example.com/webhooks/:path*" },
    { "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
