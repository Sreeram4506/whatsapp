# ─────────────────────────────────────────────────────────────
# ConstituencyOS AI — server configuration. Copy to server/.env
# Never commit real secrets. All values below are placeholders.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
PORT=4000
# MongoDB Atlas. Include the database name in the URI.
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/constituencyos?retryWrites=true&w=majority
# Used only by `npm test`; it must point to a separate database ending in `_test`.
TEST_DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/constituencyos_test?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
SESSION_HOURS=8
# Browser origin(s) allowed to call the API with credentials (comma separated)
WEB_ORIGIN=http://localhost:5180
# Public URL of the web app (used in privacy-notice links sent to citizens)
PUBLIC_WEB_URL=http://localhost:5180
# Private attachment storage (local disk). Use object storage in production — see docs/DEPLOYMENT.md
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5
# Browser-based WhatsApp simulator for demos. Set to false in production.
SIMULATOR_ENABLED=true
# Expose the shared sample sign-in on the public login page; enable only for a sample-data demo
DEMO_LOGIN_HINTS=true
# Overdue-escalation sweep interval (0 disables the background job)
ESCALATION_JOB_INTERVAL_MINUTES=15
LOG_LEVEL=info

# --- Meta WhatsApp Business Platform (Cloud API) — see docs/WHATSAPP_SETUP.md ---
WHATSAPP_GRAPH_API_VERSION=v26.0
# Any random string; paste the same value into the Meta App Dashboard webhook config
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta App Dashboard → App settings → Basic (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Default system-user access token. A tenant can point to a different env var via whatsappTokenEnvKey.
WHATSAPP_ACCESS_TOKEN=
# Approved template used for status updates outside the 24-hour customer-service window
WHATSAPP_TEMPLATE_STATUS_UPDATE=
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_TE=te

# --- AI provider — see docs/AI_PROVIDER_SETUP.md ---
# anthropic | openai-compatible | none   (none = deterministic rule-based demo mode)
# Set `openai-compatible` when using OPENAI_API_KEY.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — reasoning effort for Claude requests
AI_EFFORT=low
# For OpenAI, use the official API endpoint and set only OPENAI_API_KEY.
# OpenAI API key: create and store it in your deployment secret manager, never in Git.
OPENAI_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_TIMEOUT_MS=30000

# --- Speech-to-text for Telugu voice notes (integration point) ---
# openai-compatible | none
STT_PROVIDER=none
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
